# Julia: environments are resolved locally
Manifest.toml

# Generated example outputs (each example writes to its own output/)
examples/*/output/
*.gif

# Documenter HTML build
docs/build/

# LaTeX build junk
*.aux
*.log
*.out
*.toc
*.synctex.gz

# Built manuals (regenerate with docs/make_pdf.jl). Do not commit PDF or TEX.
docs/pdf/*.pdf
docs/pdf/*.tex

# Jupyter
.ipynb_checkpoints/
examples/_nb_cache/

# IDE
.vscode/
.idea/